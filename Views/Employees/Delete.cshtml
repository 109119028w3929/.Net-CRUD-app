@model EmployeeCrudApp.Models.Employee

<h2>Delete Employee</h2>

<h4>
    Are you sure you want to delete this employee?
</h4>

<div>

    <p>@Model.Name</p>

    <p>@Model.Email</p>

</div>

<form asp-action="Delete">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

</form>